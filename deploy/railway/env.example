# ========================================================
# LexiLearn - Railway Environment Variables Template
# Copy từ file .env local của bạn vào tab Variables trên Railway Dashboard
# ========================================================

# App & Database (Lưu dữ liệu vào volume /app/storage)
TEACHER_ACCESS_CODE=changeme
DATABASE_URL=sqlite:////app/storage/lexilearn.db
STORAGE_DIR=/app/storage
CORS_ORIGINS=*

# AI — Groq (LLM + OCR + STT fallback)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_MODEL_70B=openai/gpt-oss-120b
GROQ_MODEL_8B=openai/gpt-oss-20b
GROQ_WRITING_MODEL=openai/gpt-oss-120b
GROQ_OCR_MODEL=qwen/qwen3.6-27b

# AI — Gemini (Chấm Speaking)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# Speaking Tiers
TIER_EXAM=70b,70b,8b
TIER_PRACTICE=70b,8b,8b
TIER_BUDGET=8b,8b,8b

# STT Cloud Providers (Deepgram & Cloudflare Workers)
STT_PROVIDER=ensemble
STT_ENSEMBLE_PROVIDERS=deepgram,cloudflare
STT_ENSEMBLE_MIN_PROVIDERS=2
STT_LATENCY_PROFILE=fast
STT_PROFILE_VERSION=multi-asr-fast-en-v2
WHISPER_PRELOAD=false

# Cloud STT Credentials
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
DEEPGRAM_STT_MODEL=nova-3
CLOUDFLARE_WORKER_URL=YOUR_CLOUDFLARE_WORKER_URL
CLOUDFLARE_WORKER_TOKEN=YOUR_CLOUDFLARE_WORKER_TOKEN
CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# Scoring & Guardrails
SCORING_VERSION=ielts-evidence-ensemble-v4
CALIBRATION_VERSION=uncalibrated
SPEAKING_ASYNC_DEFAULT=true
AUDIO_RETENTION_DAYS=90
MAX_AUDIO_SECONDS=600
DAILY_SUBMIT_LIMIT_PER_STUDENT=40
MONTHLY_SPEND_CAP_USD=130
