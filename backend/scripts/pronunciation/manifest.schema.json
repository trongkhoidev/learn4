{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "learn4-pronunciation-dataset-manifest-v1",
  "title": "Learn4 pronunciation dataset manifest",
  "description": "Metadata-only manifest for the examiner-labelled pronunciation dataset. Raw audio is referenced by checksum only and never committed.",
  "type": "object",
  "required": ["schema_version", "datasets", "sessions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "learn4-pronunciation-dataset-manifest-v1"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "license", "license_url", "provenance"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "source": {"type": "string", "minLength": 1},
          "uri": {"type": "string"},
          "license": {"type": "string", "minLength": 1},
          "license_url": {"type": "string", "minLength": 1},
          "provenance": {"type": "object"},
          "notes": {"type": "string"}
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "session_id", "speaker", "dataset_id", "split",
          "consent_until", "audio_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "session_id": {"type": "string", "minLength": 1},
          "speaker": {"type": "string", "minLength": 1},
          "dataset_id": {"type": "string", "minLength": 1},
          "split": {"enum": ["train", "validation", "test"]},
          "consent_until": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "audio_path": {
            "description": "Optional private-storage reference used by the extraction run; raw audio itself is never committed and the checksum identifies the source of truth.",
            "type": "string",
            "minLength": 1
          },
          "acoustic": {
            "type": "object",
            "properties": {
              "region": {"type": "string"},
              "device": {"type": "string"},
              "noise": {"type": "string"},
              "part": {"type": "string"}
            }
          },
          "examiners": {
            "description": "Two independent examiner bands plus optional adjudication.",
            "type": "object",
            "required": ["first", "second"],
            "properties": {
              "first": {"$ref": "#/$defs/examiner_band"},
              "second": {"$ref": "#/$defs/examiner_band"},
              "adjudicated": {"$ref": "#/$defs/examiner_band"}
            }
          },
          "features": {
            "description": "Offline-extracted frozen feature vector (see extract_features.py).",
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "examiner_band": {
      "type": "object",
      "required": ["pronun", "rater_id"],
      "properties": {
        "pronun": {"type": "number", "minimum": 0, "maximum": 9},
        "rater_id": {
          "description": "Identifier of the human rater; the two independent ratings of a session must come from different rater IDs.",
          "type": "string",
          "minLength": 1
        },
        "rated_at": {"type": "string"}
      }
    }
  }
}
