# App
TEACHER_ACCESS_CODE=changeme
DATABASE_URL=sqlite:///./lexilearn.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage (R2 — S3-compatible; để trống sẽ dùng local ./storage)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lexilearn
R2_PUBLIC_URL=
STORAGE_DIR=./storage

# AI — Groq (LLM + OCR + STT fallback)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_MODEL_70B=openai/gpt-oss-120b
GROQ_MODEL_8B=openai/gpt-oss-20b
GROQ_WRITING_MODEL=llama-3.3-70b-versatile
GROQ_OCR_MODEL=qwen/qwen3.6-27b

# AI — Gemini (khuyến nghị cho scoring giá rẻ & chính xác)
GOOGLE_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# Speaking tiering (fluency/grammar/vocab)
TIER_EXAM=70b,70b,8b
TIER_PRACTICE=70b,8b,8b
TIER_BUDGET=8b,8b,8b

# STT self-host (faster-whisper)
WHISPER_MODEL=turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PRELOAD=true
WHISPER_CPU_THREADS=4
STT_PROVIDER=selfhost
STT_PROFILE_VERSION=whisper-en-v2
# One local decode per process; auto can use Groq after this wait expires.
STT_LOCAL_WAIT_SECONDS=30
STT_REMOTE_TIMEOUT_SECONDS=60
AUDIO_PROCESS_TIMEOUT_SECONDS=60

# Pronunciation alignment (none | whisperx | mfa)
PRONUNCIATION_ALIGNER=none
PRONUNCIATION_ALIGNMENT_DEVICE=cpu
MFA_DICTIONARY_PATH=
MFA_ACOUSTIC_MODEL_PATH=
SCORING_VERSION=ielts-diagnostic-v2
CALIBRATION_VERSION=uncalibrated

# Retention & guardrail ngân sách
AUDIO_RETENTION_DAYS=90
SPEAKING_JOB_ORPHAN_HOURS=24
MAX_AUDIO_SECONDS=600
MAX_AUDIO_BYTES=26214400
SPEAKING_JOB_MAX_ATTEMPTS=2
SPEAKING_JOB_POLL_SECONDS=0.5
SPEAKING_ASYNC_DEFAULT=true
DAILY_SUBMIT_LIMIT_PER_STUDENT=40
MONTHLY_SPEND_CAP_USD=130
